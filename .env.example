DJANGO_SETTINGS_MODULE=siteguard.settings.dev
SECRET_KEY=replace-me-for-production
DEBUG=True
BOOTSTRAP_ADMIN_ENABLED=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_BASE_URL=http://127.0.0.1:8000
CRON_SECRET=replace-with-a-random-secret
TIME_ZONE=UTC

EMAIL_BACKEND=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SENDER_NAME=SiteGuard Alerts
DEFAULT_FROM_EMAIL=SiteGuard Alerts <your-verified-sender@example.com>
SERVER_EMAIL=SiteGuard Alerts <your-verified-sender@example.com>
SUPPORT_EMAIL=your-verified-sender@example.com
EMAIL_SUBJECT_PREFIX=[SiteGuard] 
SITE_NAME=SiteGuard

# Local email behavior:
# - leave EMAIL_BACKEND blank to auto-select SMTP when EMAIL_HOST_USER/EMAIL_HOST_PASSWORD or BREVO_SMTP_LOGIN/BREVO_SMTP_PASSWORD are set
# - leave SMTP credentials blank to fall back to console email output
# - set APP_BASE_URL to your tunnel or LAN URL if you want non-localhost password reset links during local testing
SQLITE_PATH=
SQLITE_TIMEOUT=20

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
WHITENOISE_MAX_AGE=31536000
