DJANGO_SETTINGS_MODULE=siteguard.settings.dev
SECRET_KEY=replace-me-for-production
DEBUG=True
BOOTSTRAP_ADMIN_ENABLED=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_BASE_URL=http://127.0.0.1:8000
CRON_SECRET=replace-with-a-random-secret
TIME_ZONE=UTC

EMAIL_BACKEND=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_TIMEOUT=15
EMAIL_SENDER_NAME=SiteGuard Alerts
DEFAULT_FROM_EMAIL=SiteGuard Alerts <your-verified-sender@example.com>
SERVER_EMAIL=SiteGuard Alerts <your-verified-sender@example.com>
SUPPORT_EMAIL=your-verified-sender@example.com
EMAIL_SUBJECT_PREFIX=[SiteGuard] 
SITE_NAME=SiteGuard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AI_FEATURES_ENABLED=False
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SESSION_ENGINE=django.contrib.sessions.backends.db
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
SESSION_SAVE_EVERY_REQUEST=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
AI_REQUEST_TIMEOUT=20
AI_MAX_TOKENS=900
AI_RETRY_ATTEMPTS=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_DEBUG_RAW_OUTPUT=False

# Local email behavior:
# - leave EMAIL_BACKEND blank to use console email output during local development
# - use Gmail SMTP locally only if you explicitly set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# - Brevo API is reserved for production-style settings and should not be the default local transport
# - set APP_BASE_URL to your tunnel or LAN URL if you want non-localhost password reset links during local testing
# - Cloudinary credentials are optional for local development because dev settings keep uploads on the local filesystem
# - AI features are disabled by default and only make provider calls when explicitly requested in the UI
# - Gemini is the default AI provider and uses the official google-generativeai SDK
# - set AI_DEBUG_RAW_OUTPUT=True temporarily to log a safe raw Gemini text preview during parser debugging
# - set AI_PROVIDER=openai to use the OpenAI provider instead
# - production on Render should keep SECRET_KEY stable and should use SESSION_ENGINE=django.contrib.sessions.backends.signed_cookies unless you move sessions to a persistent external store
SQLITE_PATH=
SQLITE_TIMEOUT=20

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
EMAIL_LOG_LEVEL=INFO
RUNTIME_LOG_LEVEL=INFO
WHITENOISE_MAX_AGE=31536000
