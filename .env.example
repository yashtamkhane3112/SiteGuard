DJANGO_SETTINGS_MODULE=siteguard.settings.dev
SECRET_KEY=replace-me-for-production
DEBUG=True
BOOTSTRAP_ADMIN_ENABLED=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_BASE_URL=http://127.0.0.1:8000
CRON_SECRET=replace-with-a-random-secret
TIME_ZONE=UTC

EMAIL_BACKEND=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_TIMEOUT=15
EMAIL_SENDER_NAME=SiteGuard Alerts
DEFAULT_FROM_EMAIL=SiteGuard Alerts <your-verified-sender@example.com>
SERVER_EMAIL=SiteGuard Alerts <your-verified-sender@example.com>
SUPPORT_EMAIL=your-verified-sender@example.com
EMAIL_SUBJECT_PREFIX=[SiteGuard] 
SITE_NAME=SiteGuard

# Local email behavior:
# - leave EMAIL_BACKEND blank to auto-select the Brevo HTTPS API when BREVO_API_KEY is set
# - leave BREVO_API_KEY blank to fall back to console email output during local development
# - set APP_BASE_URL to your tunnel or LAN URL if you want non-localhost password reset links during local testing
SQLITE_PATH=
SQLITE_TIMEOUT=20

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
WHITENOISE_MAX_AGE=31536000
